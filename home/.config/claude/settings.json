{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "high",
  "theme": "dark",
  "editorMode": "vim",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(shellcheck *)",
      "Bash(nix eval *)",
      "Bash(nix flake check *)",
      "Bash(nix flake show *)",
      "Bash(nix fmt *)",
      "Bash(ccusage *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Agent(cavecrew-builder)",
      "Agent(cavecrew-reviewer)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    }
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true
  }
}
