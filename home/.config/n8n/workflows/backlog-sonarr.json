      "position": [
        700,
        800
      ],
      "parameters": {
        "jsCode": "return $input.all().filter(s => s.json.monitored);"
      }
    },
    {
      "id": "519c057b-385e-594a-bfd2-066c8d8f5cb9",
      "name": "Sonarr episodes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        800
      ],
      "parameters": {
        "url": "http://127.0.0.1:8989/api/v3/episode",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "seriesId",
              "value": "={{ $json.id }}"
            },
            {
              "name": "includeEpisodeFile",
              "value": "true"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.SONARR_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "644aa30a-aaf0-5fc3-8e49-ac5838e74553",
      "name": "Sonarr pick upgrades",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        800
      ],
      "parameters": {
        "jsCode": "// monitored episodes whose file scores below its series' profile's format cutoff; 50 at random\nconst cutoff = Object.fromEntries($('Sonarr profiles').all().map(p => [p.json.id, p.json.cutoffFormatScore]));\nconst profile = Object.fromEntries($('Sonarr monitored series').all().map(s => [s.json.id, s.json.qualityProfileId]));\nconst below = $input.all().map(e => e.json)\n  .filter(e => e.monitored && e.hasFile && e.episodeFile\n    && e.episodeFile.customFormatScore < cutoff[profile[e.seriesId]])\n  .map(e => e.id);\nfor (let i = below.length - 1; i > 0; i--) {\n  const j = Math.floor(Math.random() * (i + 1));\n  [below[i], below[j]] = [below[j], below[i]];\n}\nconst ids = below.slice(0, 50);\nreturn ids.length ? [{ json: { name: 'EpisodeSearch', episodeIds: ids } }] : [];"
      }
    },
    {
      "id": "652c8301-9d4c-5f4c-9538-1c7551105b53",
      "name": "Sonarr search upgrades",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        800
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8989/api/v3/command",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.SONARR_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "fe694777-aacf-456e-a7a6-02e4dd051dac",
      "name": "Key set",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        130,
        400
      ],
      "parameters": {
        "jsCode": "// a host without Sonarr's key has nothing to search\nreturn $env.SONARR_API_KEY ? $input.all() : [];"
      }
    }
  ],
