    },
    {
      "id": "376fd46d-294d-5579-b0ca-d61bd37e5c54",
      "name": "Radarr pick upgrades",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        640
      ],
      "parameters": {
        "jsCode": "// movies whose file scores below its profile's format cutoff; 50 of them at random\nconst cutoff = Object.fromEntries($('Radarr profiles').all().map(p => [p.json.id, p.json.cutoffFormatScore]));\nconst profile = Object.fromEntries($('Radarr movies').all().map(m => [m.json.id, m.json.qualityProfileId]));\nconst below = [...new Set($input.all().map(f => f.json)\n  .filter(f => f.customFormatScore < cutoff[profile[f.movieId]])\n  .map(f => f.movieId))];\nfor (let i = below.length - 1; i > 0; i--) {\n  const j = Math.floor(Math.random() * (i + 1));\n  [below[i], below[j]] = [below[j], below[i]];\n}\nconst ids = below.slice(0, 50);\nreturn ids.length ? [{ json: { name: 'MoviesSearch', movieIds: ids } }] : [];"
      }
    },
    {
      "id": "bd8c2204-b643-51b7-8999-8d41739e3248",
      "name": "Radarr search upgrades",
      "type": "n8n-nodes-base.httpRequest",
