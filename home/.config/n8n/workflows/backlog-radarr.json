            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "7f3071cc-5c57-433c-99ba-bef2c3fef333",
      "name": "Key set",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        130,
        400
      ],
      "parameters": {
        "jsCode": "// a host without Radarr's key has nothing to search\nreturn $env.RADARR_API_KEY ? $input.all() : [];"
      }
    }
