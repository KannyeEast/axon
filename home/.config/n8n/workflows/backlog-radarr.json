        "url": "=http://127.0.0.1:7878/api/v3/moviefile?{{ $('Radarr movies').all().filter(m => m.json.monitored && m.json.hasFile).map(m => 'movieId=' + m.json.id).join('&') }}",
        "sendHeaders": true,
