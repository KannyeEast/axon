// Renovate (modules/features/forge/updates.nix) reads this from the repository's default branch.
// Its pull requests go into dev, where the check and review workflow merges the clean ones.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  baseBranchPatterns: ["dev"],
  enabledManagers: ["nix", "custom.regex"],
  nix: { enabled: true },
  prConcurrentLimit: 5,
  customManagers: [
    {
      // image = "<registry>/<name>:<tag>@sha256:<digest>" of a container (virtualisation.oci-containers)
      customType: "regex",
      managerFilePatterns: ["/\\.nix$/"],
      matchStrings: [
        "image = \"(?<depName>[^\":@]+):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[0-9a-f]{64})\"",
      ],
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      // every flake input in one pull request a week
      matchManagers: ["nix"],
      groupName: "flake inputs",
      schedule: ["before 6am on monday"],
    },
    {
      // its registry also holds commit tags, some of them all digits
      matchPackageNames: ["ghcr.io/moghtech/komodo-core"],
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+$/",
    },
    {
      // FerretDB and the Postgres it runs on move together
      matchPackageNames: ["ghcr.io/ferretdb/ferretdb", "ghcr.io/ferretdb/postgres-documentdb"],
      groupName: "ferretdb",
    },
    {
      // <postgres major>-<documentdb version>-ferretdb-<ferretdb version>; the major stays, as a new
      // one can't read the old one's data
      matchPackageNames: ["ghcr.io/ferretdb/postgres-documentdb"],
      versioning: "regex:^(?<compatibility>\\d+)-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ferretdb-\\d+\\.\\d+\\.\\d+$",
    },
  ],
}
