// What runs with the session (stopgap until quickshell is rewritten).
// mako starts by itself on the first notification; KeePassXC and the polkit agent are services.
spawn-at-startup "waybar"
spawn-at-startup "swaybg" "-i" "/home/gldn/Pictures/Wallpapers/48FBjzC.jpeg" "-m" "fill"
// lock after 15 minutes, monitors off after 20; video players and browsers playing video hold it off
spawn-at-startup "swayidle" "-w" "timeout" "900" "swaylock -f" "timeout" "1200" "niri msg action power-off-monitors" "before-sleep" "swaylock -f"
