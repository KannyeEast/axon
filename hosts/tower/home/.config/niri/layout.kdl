layout {
    gaps 4
    center-focused-column "never"
    // Wait for https://github.com/niri-wm/niri/pull/2240 to merge
    // always-center-single-column

    default-column-display "tabbed"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    border {
        on
        width 3
    }

    focus-ring {
        width 1
    }

    // a bar along the top of the column, one segment per tab; outside the column it fell into
    // the 4px gap between columns and couldn't be seen
    tab-indicator {
        hide-when-single-tab
        place-within-column
        position "top"
        width 6
        length total-proportion=1.0
        gaps-between-tabs 4
    }
}
