workspace "side" {
    open-on-output "PNP(BNQ) ZOWIE XL LCD EBLAL01265SL0"
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match at-startup=true app-id=r#"^org\.keepassxc\.KeePassXC$"#
    open-on-workspace "side"
}

// Keep credentials out of screenshots and screen shares
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

// Dialogs and pickers are transient by nature
window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"# title=r#"^(Open|Save|Rename)"#
    open-floating true
}

// Small or short-lived windows: players, previews, utilities, an IDE's project picker
window-rule {
    match app-id=r#"^mpv$"#
    match app-id=r#"^com\.github\.iwalton3\.jellyfin-mpv-shim$"#
    match app-id=r#"^org\.gnome\.NautilusPreviewer$"#
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^jetbrains-"# title=r#"^Welcome to "#
    match app-id=r#"^org\.gnome\.Nautilus$"# title=r#"Properties$"#
    open-floating true
}

// Password prompts should land in front and stay put: the agent by any app id containing its name,
// or by the dialog's title
window-rule {
    match app-id=r#"lxqt-policykit"#
    match title=r#"^Authentication Required$"#
    open-floating true
    open-focused true
}

// KeePassXC's prompts (passkeys, browser access, unlock) answer another app's request, so
// niri wouldn't focus them by itself; they open next to the main window on the side screen
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"# title=r#"^(KeePassXC - |Unlock Database - KeePassXC$)"#
    open-floating true
    open-focused true
}
