{
  "host.json": {
    "type": "attrs",
    "required": true,
    "default": null,
    "prompt": "none",
    "description": "What this machine is",
    "properties": {
      "flake": {
        "type": "string",
        "required": true,
        "default": null,
        "prompt": "detect",
        "description": "Absolute path to this repository on the machine"
      },
      "host": {
        "type": "attrs",
        "required": true,
        "default": null,
        "prompt": "none",
        "description": "The machine itself",
        "properties": {
          "system": {
            "type": { "enum": [ "x86_64-linux", "aarch64-linux" ] },
            "required": true,
            "default": null,
            "prompt": "choose",
            "description": "machine architecture"
          },
          "stateVersion": {
            "type": "string",
            "required": true,
            "default": "26.05",
            "prompt": "detect",
            "description": "Release the on-disk state was created with; set at install, never changed"
          },
          "class": {
            "type": { "enum": [ "desktop", "server" ] },
            "required": true,
            "default": null,
            "prompt": "choose",
            "description": "Exactly one class bundle"
          },
          "addons": {
            "type": "list",
            "required": false,
            "default": [],
            "prompt": "choose",
            "description": "Extra bundles for this machine only"
          },
          "publicKey": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "detect",
            "description": "ssh host key; trusted by every other host"
          }
        }
      },
      "user": {
        "type": "attrs",
        "required": true,
        "default": null,
        "prompt": "none",
        "description": "The one login user",
        "properties": {
          "name": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "ask",
            "description": "Login name; home is /home/<name>"
          },
          "email": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "ask",
            "description": "Git identity, ACME and Authelia contact"
          },
          "publicKey": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "detect",
            "description": "User ssh key; login and commit signing"
          }
        }
      },
      "hardware": {
        "type": "attrs",
        "required": false,
        "default": {},
        "prompt": "none",
        "description": "What is in the machine",
        "properties": {
          "gpu": {
            "type": "list",
            "required": false,
            "default": [],
            "prompt": "choose",
            "description": "GPU vendors present: amd, intel, nvidia"
          },
          "modules": {
            "type": "list",
            "required": false,
            "default": [],
            "prompt": "choose",
            "description": "nixos-hardware module names"
          },
          "busId": {
            "type": { "attrsOf": "string" },
            "required": false,
            "default": null,
            "prompt": "none",
            "description": "PCI address per vendor; only for nvidia prime offload; absent means unknown"
          }
        }
      },
      "locale": {
        "type": "attrs",
        "required": true,
        "default": null,
        "prompt": "none",
        "description": "Time, language and keyboard",
        "properties": {
          "timeZone": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "choose",
            "description": "tz database name"
          },
          "default": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "choose",
            "description": "Main locale"
          },
          "extra": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "choose",
            "description": "Locale used for formats"
          },
          "xkb": {
            "type": "attrs",
            "required": true,
            "default": null,
            "prompt": "none",
            "description": "Keyboard layout, console and desktop alike",
            "properties": {
              "layout": {
                "type": "string",
                "required": true,
                "default": null,
                "prompt": "choose",
                "description": "xkb layout"
              },
              "variant": {
                "type": "string",
                "required": false,
                "default": "",
                "prompt": "choose",
                "description": "xkb variant"
              }
            }
          }
        }
      }
    }
  },

  "cluster.json": {
    "type": "attrs",
    "required": false,
    "default": {},
    "prompt": "none",
    "description": "How the machines relate; absent behaves as empty",
    "properties": {
      "domain": {
        "type": "string",
        "required": false,
        "default": null,
        "prompt": "none",
        "description": "Domain services are published under"
      },
      "volumes": {
        "type": { "attrsOf": "attrs" },
        "required": false,
        "default": {},
        "prompt": "none",
        "description": "Shared stores, by name",
        "properties": {
          "host": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "none",
            "description": "Member holding this volume"
          },
          "path": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "none",
            "description": "Mountpoint on that member"
          }
        }
      },
      "members": {
        "type": { "attrsOf": "attrs" },
        "required": false,
        "default": {},
        "prompt": "none",
        "description": "Every machine taking part, built here or not",
        "properties": {
          "addons": {
            "type": "list",
            "required": false,
            "default": [],
            "prompt": "none",
            "description": "Bundles this member runs for the cluster"
          },
          "ssh": {
            "type": "attrs",
            "required": false,
            "default": {},
            "prompt": "none",
            "description": "Who this member can log in to",
            "properties": {
              "key": {
                "type": "string",
                "required": false,
                "default": null,
                "prompt": "none",
                "description": "User key, for members without a host.json"
              },
              "to": {
                "type": "list",
                "required": false,
                "default": [],
                "prompt": "none",
                "description": "Members this one can log in to"
              }
            }
          },
          "syncthing": {
            "type": "attrs",
            "required": false,
            "default": null,
            "prompt": "none",
            "description": "Present means this member runs syncthing",
            "properties": {
              "id": {
                "type": "string",
                "required": true,
                "default": null,
                "prompt": "none",
                "description": "Syncthing device id"
              },
              "address": {
                "type": "string",
                "required": false,
                "default": null,
                "prompt": "none",
                "description": "Where to reach it; absent means discover"
              },
              "to": {
                "type": { "attrsOf": "list" },
                "required": false,
                "default": {},
                "prompt": "none",
                "description": "Folders shared with each peer"
              }
            }
          }
        }
      }
    }
  },

  "secrets.json": {
    "type": "attrs",
    "required": true,
    "default": null,
    "prompt": "none",
    "description": "sops-encrypted; key names are public, values are not",
    "properties": {
      "user-password": {
        "type": "string",
        "required": true,
        "default": null,
        "prompt": "ask",
        "description": "Hashed login password"
      },
      "user-privatekey": {
        "type": "string",
        "required": true,
        "default": null,
        "prompt": "detect",
        "description": "User ssh private key; also the sops editing key"
      },
      "tailscale-authkey": {
        "type": "string",
        "required": false,
        "default": null,
        "prompt": "ask",
        "description": "Present means tailscale logs in by itself"
      },
      "wifi": {
        "type": { "attrsOf": "attrs" },
        "required": false,
        "default": {},
        "prompt": "ask",
        "description": "NetworkManager profiles by name; sections and keys pass through as-is",
        "properties": null
      },
      "cloudflare-token": {
        "type": "string",
        "required": false,
        "default": null,
        "prompt": "none",
        "description": "DNS challenge token; gateway only"
      },
      "authelia": {
        "type": "attrs",
        "required": false,
        "default": null,
        "prompt": "none",
        "description": "Authelia secrets; gateway only",
        "properties": {
          "admin-hash": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "none",
            "description": "Seed password hash for the admin user"
          },
          "jwt": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "none",
            "description": "JWT secret"
          },
          "session": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "none",
            "description": "Session secret"
          },
          "storage": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "none",
            "description": "Storage encryption key"
          }
        }
      },
      "backup": {
        "type": { "attrsOf": "attrs" },
        "required": false,
        "default": {},
        "prompt": "none",
        "description": "Restic targets by name",
        "properties": {
          "password": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "none",
            "description": "Repository password"
          },
          "repository_unencrypted": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "none",
            "description": "Repository location; plain, read at eval"
          },
          "schedule_unencrypted": {
            "type": "string",
            "required": true,
            "default": null,
            "prompt": "none",
            "description": "systemd OnCalendar; plain, read at eval"
          },
          "env": {
            "type": { "attrsOf": "string" },
            "required": false,
            "default": {},
            "prompt": "none",
            "description": "Extra environment; keys ending _unencrypted stay plain"
          }
        }
      }
    }
  }
}